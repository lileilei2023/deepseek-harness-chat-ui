{
  "name": "deepseek-harness-chat-ui",
  "version": "0.1.0-alpha.1",
  "description": "Social-network-style AI agent UI with personified Skills, direct messages, group chats and automations for DeepSeek Harness",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "source",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "js-yaml": "^4.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-agent-default-model": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session-title": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-subprocess": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-terminal": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-workspace": "0.1.2-alpha.5",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-agent-default-model": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-session-title": { "optional": true },
    "@deepseek-ai/dsh-subprocess": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-terminal": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true },
    "@deepseek-ai/dsh-workspace": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-agent-default-model": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session-title": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-subprocess": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-terminal": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-workspace": "0.1.2-alpha.5",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "scripts": {
    "build": "node scripts/build-with-harness.mjs",
    "check": "node scripts/check-package.mjs",
    "sync:harness": "node scripts/sync-from-harness.mjs",
    "rebuild": "node scripts/rebuild.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugin",
    "deepseek-chat-ui",
    "ai-agent-chat",
    "multi-agent-chat",
    "social-ai",
    "group-chat",
    "skill-chat",
    "agent-rooms",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lileilei2023/deepseek-harness-chat-ui.git"
  },
  "homepage": "https://github.com/lileilei2023/deepseek-harness-chat-ui#readme",
  "bugs": {
    "url": "https://github.com/lileilei2023/deepseek-harness-chat-ui/issues"
  },
  "license": "MIT"
}
